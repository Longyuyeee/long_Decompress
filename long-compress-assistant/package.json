{
  "name": "long-compress-assistant",
  "private": true,
  "version": "1.1.2",
  "author": "Longyuyeee",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "vue-tsc && vite build",
    "build:shell-extension": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-shell-extension.ps1",
    "build:context-menu-package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-context-menu-package.ps1",
    "test:context-menu-package": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-context-menu-package.ps1",
    "test:release-identity": "node scripts/check-release-identity.mjs",
    "test:installed-release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-installed-release.ps1",
    "test:public-update": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/test-public-update.ps1",
    "release:validation-report": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/generate-release-validation.ps1",
    "performance:baseline": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-performance-baseline.ps1",
    "performance:io-baseline": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-performance-baseline.ps1 -IoTopologyOnly",
    "performance:io-matrix": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-io-performance-matrix.ps1",
    "build:check": "vue-tsc && vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "vue-tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:unit": "vitest run src tests/fixtures",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:performance": "vitest run tests/performance tests/integration/performance_integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "node scripts/test-tauri-desktop.mjs",
    "test:e2e:desktop:watch-folder": "node scripts/test-tauri-desktop.mjs --watch-folder-lifecycle-only",
    "test:e2e:desktop:resource-preflight": "node scripts/test-tauri-desktop.mjs --resource-preflight-only",
    "test:e2e:desktop:full-format": "node scripts/test-tauri-desktop.mjs --require-full-format-matrix",
    "test:fixtures:archives": "node scripts/fetch-archive-test-fixtures.mjs",
    "test:tools:qemu-img": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-qemu-img-test-tool.ps1",
    "test:tools:wsl-fs": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-wsl-fs-test-tools.ps1",
    "test:tools:wix3": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-wix3-test-tool.ps1",
    "test:tools:apfs": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-apfs-test-tool.ps1",
    "test:fixtures:ovmf": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-ovmf-test-fixture.ps1",
    "test:fixtures:hfsx": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-hfsx-test-fixture.ps1",
    "test:prepare:full-format": "npm run test:fixtures:archives && npm run test:tools:qemu-img && npm run test:tools:wsl-fs && npm run test:tools:wix3 && npm run test:tools:apfs && npm run test:fixtures:ovmf && npm run test:fixtures:hfsx",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test": "npm run test:unit && npm run test:e2e",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:performance && npm run test:e2e",
    "test:generate-data": "bash scripts/generate_performance_test_files.sh --all",
    "test:run-performance": "bash scripts/run_performance_tests.sh",
    "bench:rust": "cd src-tauri && cargo bench"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.5.3",
    "gsap": "^3.15.0",
    "pinia": "^2.1.7",
    "primeicons": "^7.0.0",
    "vue": "^3.5.40",
    "vue-draggable-next": "^2.3.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^1.5.12",
    "@testing-library/vue": "^6.6.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "7zip-bin": "^5.2.0",
    "autoprefixer": "^10.5.4",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.25",
    "selenium-webdriver": "^4.46.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "picomatch": "^4.0.1",
    "@vue/compiler-dom": "3.5.40",
    "@vue/compiler-sfc": "3.5.40",
    "@vue/compiler-core": "3.5.40",
    "@vue/runtime-dom": "3.5.40",
    "@vue/runtime-core": "3.5.40"
  }
}
