{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "package": {
    "productName": "Long解压·方便助手",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.longcompress.assistant",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [],
      "externalBin": [],
      "copyright": "Copyright © 2026 Long解压·方便助手",
      "category": "Utility",
      "shortDescription": "智能压缩解压助手",
      "longDescription": "支持多种格式、密码本管理、批量处理的现代化压缩解压工具 - ZIP/7Z/RAR/TAR/Zstd 等37+格式",
      "windows": {
        "wix": {
          "language": "zh-CN"
        },
        "nsis": {
          "languages": ["SimpChinese", "English"],
          "installMode": "currentUser"
        }
      },
      "deb": {
        "depends": []
      },
      "rpm": {
        "depends": []
      },
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "10.15",
        "license": "LICENSE"
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Long解压",
        "width": 720,
        "height": 540,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true
      }
    ]
  }
}